{
	"baseUrl": "https://www.qravate.com/api/v1",
	"headers": {
		"Authorization": "Bearer {{connection.apiKey}}",
		"Accept": "application/json"
	},
	"response": {
		"error": {
			"message": "[{{statusCode}}] {{body.error.message}}"
		}
	},
	"log": {
		"sanitize": [
			"request.headers.authorization"
		]
	}
}
